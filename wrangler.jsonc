{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magical-athlete",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "vars": {
    "DUAL_BACKEND_ENABLED": "true",
    "MULTIPLAYER_ROOM_LIMIT": "14",
    "PUBLIC_ORIGINS": "https://athlete.magical-athlete-online.cn,http://115.29.188.62,http://magical-athlete-online.cn",
    "BACKENDS_CONFIG_JSON": "{\"backends\":[{\"id\":\"cloudflare\",\"origin\":\"\",\"transport\":\"worker\",\"enabled\":true},{\"id\":\"aliyun\",\"origin\":\"https://athlete.magical-athlete-online.cn\",\"transport\":\"socketio\",\"enabled\":true}]}"
  },
  "assets": {
    "directory": "./dist/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/backends.json"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomRelay"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
