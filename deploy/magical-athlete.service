[Unit]
Description=Magical Athlete authoritative room server
After=network-online.target
Wants=network-online.target

[Service]
User=athlete
Group=athlete
WorkingDirectory=/opt/magical-athlete/current
EnvironmentFile=/etc/magical-athlete/server.env
ExecStart=/opt/node/bin/node dist/server/server/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/magical-athlete

[Install]
WantedBy=multi-user.target
