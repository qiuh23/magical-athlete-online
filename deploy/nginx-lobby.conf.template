# Staged template only. Render the confirmed apex and review before installing.
# No dependency on Cloudflare, no new process, no database permissions.
# The release tree is intentionally root:athlete 0750. Serve only its public
# lobby through the existing Node static handler; do not widen www-data access.
server {
    listen 80;
    server_name __APEX_DOMAIN__;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        try_files $uri =404;
    }
    # Keep the old HTTP game origin and its browser identities. The new HTTPS
    # apex below is the lobby; HTTP is deliberately not redirected to it.
    client_max_body_size 16k;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 100s;
        proxy_send_timeout 100s;
        proxy_buffering off;
    }
}
server {
    listen 443 ssl;
    server_name __APEX_DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/__APEX_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__APEX_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # Deliberately no HSTS includeSubDomains/preload during the HTTP transition.
    location = / {
        proxy_pass http://127.0.0.1:3000/lobby/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }
    # Explicit public-file allowlist; never expose game/API/Socket.IO at apex.
    # Node sends correct JavaScript MIME for .mjs even if nginx mime.types omits it.
    location ~ ^/(index\.html|config\.json|build-info\.json|style\.css|app\.mjs|routing\.mjs|favicon\.svg|art/(athlete|wizard|catan)\.svg)$ {
        rewrite ^/(.*)$ /lobby/$1 break;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }
    location / { return 404; }
}
