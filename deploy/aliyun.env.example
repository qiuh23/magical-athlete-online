# Copy to /etc/magical-athlete/server.env (root:athlete, mode 0640).
# Never put AccessKeys, private keys or payment details here or in Git.
NODE_ENV=production
SITE_EDITION=cn
BACKEND_ID=aliyun
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/magical-athlete
TRUST_PROXY=1
DUAL_BACKEND_ENABLED=true
MULTIPLAYER_ROOM_LIMIT=15
PUBLIC_ACCESS_ENABLED=false
CONTROLLED_VALIDATION=false
PUBLIC_ORIGIN=https://REPLACE_WITH_FILED_DOMAIN
PUBLIC_ORIGINS=https://athlete.magical-athlete-online.cn,http://115.29.188.62,http://magical-athlete-online.cn
# Independently hosted HTML/assets; CF may be unreachable on the client.
# HTTP can use PUBLIC_ORIGIN=http://INSTANCE_IPV4 via publish-http.sh (controlled
# by default; explicit PUBLIC_HTTP_ACCESS=true supports public IPv4 sources).
# HTTP does not waive filing requirements; pending filing remains pending.
BACKENDS_CONFIG_JSON='{"siteEdition":"cn","backends":[{"id":"aliyun","origin":"","transport":"socketio","enabled":true}]}'
