# Copy to /etc/magical-athlete/server.env (root:athlete, mode 0640).
# Never put AccessKeys, private keys or payment details here or in Git.
NODE_ENV=production
BACKEND_ID=aliyun
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/magical-athlete
TRUST_PROXY=1
DUAL_BACKEND_ENABLED=true
MULTIPLAYER_ROOM_LIMIT=15
PUBLIC_ACCESS_ENABLED=false
CONTROLLED_VALIDATION=false
PUBLIC_ORIGIN=https://REPLACE_WITH_FILED_DOMAIN
PUBLIC_ORIGINS=https://magical-athlete.qiuh23.workers.dev
# Independently hosted HTML/assets; CF may be unreachable on the client.
# Controlled HTTP can use PUBLIC_ORIGIN=http://INSTANCE_IPV4 with the dedicated
# source-IP-restricted publish-http.sh. HTTP does not waive filing requirements.
# Enable unrestricted Aliyun only after qualification, HTTPS and real-network validation.
BACKENDS_CONFIG_JSON='{"backends":[{"id":"cloudflare","origin":"https://magical-athlete.qiuh23.workers.dev","transport":"worker","enabled":true},{"id":"aliyun","origin":"","transport":"socketio","enabled":false}]}'
